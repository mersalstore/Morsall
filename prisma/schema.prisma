generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  role          String    @default("CUSTOMER")
  age           Int?
  interests     String?
  isOnboarded   Boolean   @default(false)
  lastIp        String?
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  permissions   Json?
  accounts      Account[]
  orders        Order[]
  reviews       Review[]
  sessions      Session[]
  vendorProfile Vendor?
  vendorReviews VendorReview[]
  deliveryDriverProfile DeliveryDriver?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vendor {
  id                 String            @id @default(cuid())
  userId             String            @unique
  storeName          String
  storeDescription   String?           @db.Text
  bankStatementUrl   String?           @db.Text
  commercialRegUrl   String?           @db.Text
  status             String            @default("PENDING")
  commissionType     String            @default("PERCENTAGE")
  commissionRate     Float             @default(10.0)
  fixedFee           Float             @default(0.0)
  subscriptionFee    Float             @default(0.0)
  location           String?
  shippingModel      String            @default("VENDOR_PACKS")
  phone              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  isTrialUsed        Boolean           @default(false)
  planId             String?
  slug               String?           @unique
  subscriptionEndsAt DateTime?
  address            String?
  facebookUrl        String?
  instagramUrl       String?
  primaryColor       String            @default("#0F1629")
  secondaryColor     String            @default("#3B82F6")
  storeBanner        String?           @db.Text
  storeLogo          String?           @db.Text
  whatsappNumber     String?
  rejectionReason    String?           @db.Text
  walletBalance      Float             @default(0)
  storeDesign        String?           @db.Text
  tier               VendorPlan         @default(FREEMIUM)
  stripeCustomerId   String?
  customSubscriptionFee Float?
  paymentTransactions  PaymentTransaction[]
  customDesignRequests CustomDesignRequest[]
  coupons            Coupon[]
  orderItems         OrderItem[]
  products           Product[]
  plan               SubscriptionPlan? @relation(fields: [planId], references: [id])
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals        Withdrawal[]
  reviews            VendorReview[]
  supplyRequests     SupplyRequest[]
}

enum VendorPlan {
  FREEMIUM
  PREMIUM_BUILDER
  CUSTOM_DESIGN
}

model SubscriptionPlan {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique // "freemium", "premium-builder", "custom-design"
  price             Float
  durationDays      Int
  isTrial           Boolean            @default(false)
  canUploadProducts Boolean            @default(false)
  canUseBuilder     Boolean            @default(false)
  canCustomDesign   Boolean            @default(false)
  maxProducts       Int                @default(0)
  maxBlocks         Int                @default(0)
  stripePriceId     String?            @unique
  billingCycle      String             @default("MONTHLY")
  accountType       String             @default("FIXED")
  features          Json?              // ["رفع المنتجات", "منشئ المواقع", ...]
  createdAt         DateTime           @default(now())
  vendors           Vendor[]
  paymentTransactions PaymentTransaction[]
}

model PaymentTransaction {
  id                     String   @id @default(cuid())
  vendorId               String
  planId                 String?
  amount                 Float
  currency               String   @default("SDG")
  status                 String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  stripeSessionId        String?  @unique
  stripePaymentIntentId  String?
  stripeSubscriptionId   String?
  paymentMethod          String?  // "stripe", "bank_transfer", "wallet"
  screenshotUrl          String?  @db.Text   // URL of bank transfer screenshot
  aiConfidence           Float?              // 0-100 OCR confidence
  aiData                 Json?               // { details, flags, ocrTextHash, ... }
  notes                  String?  @db.Text   // Admin notes
  createdAt              DateTime @default(now())
  completedAt            DateTime?
  vendor                 Vendor   @relation(fields: [vendorId], references: [id])
  plan                   SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([vendorId])
  @@index([stripeSessionId])
}

model CustomDesignRequest {
  id              String   @id @default(cuid())
  vendorId        String
  description     String   @db.Text
  requirements    Json?    // attachments, colors, references
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  adminNotes      String?  @db.Text
  price           Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  vendor          Vendor   @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
}

model Product {
  id               String             @id @default(cuid())
  title            String
  description      String             @db.LongText
  price            Float
  stock            Int                @default(0)
  images           String?            @db.Text
  sizes            String?
  colors           String?
  status           String             @default( "APPROVED")
  vendorId         String
  categoryId       String?
  purchaseCount    Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  brand            String?
  bundleData       String?
  height           Float?
  length           Float?
  range            String?
  shortDescription String?            @db.Text
  sku              String?
  type             String             @default("SIMPLE")
  weight           Float?
  width            Float?
  discountPrice    Float?
  discountType     String?
  rejectionReason  String?            @db.Text
  specifications   String?            @db.Text
  orderItems       OrderItem[]
  category         Category?          @relation(fields: [categoryId], references: [id])
  vendor           Vendor             @relation(fields: [vendorId], references: [id])
  attributes       ProductAttribute[]
  variations       ProductVariation[]
  reviews          Review[]
  supplyRequestItems SupplyRequestItem[]
  returnItems      ReturnItem[]
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  name      String
  values    Json
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariation {
  id          String      @id @default(cuid())
  productId   String
  sku         String?
  price       Float?
  stock       Int         @default(0)
  combination String
  image       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Attribute {
  id        String            @id @default(cuid())
  name      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  options   AttributeOption[]
}

model AttributeOption {
  id          String    @id @default(cuid())
  attributeId String
  value       String
  createdAt   DateTime  @default(now())
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
}

model Category {
  id           String     @id @default(cuid())
  name         String     @unique
  icon         String?    @db.Text
  image        String?    @db.Text
  imageUrl     String?    @db.Text
  parentId     String?
  showInNavbar Boolean    @default(false)
  parent       Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     Category[] @relation("SubCategories")
  products     Product[]
}

model Order {
  id                String          @id @default(cuid())
  customerId        String
  status            String          @default("PENDING_APPROVAL")
  totalAmount       Float
  shippingCost      Float           @default(0)
  paymentMethod     String
  city              String
  district          String
  street            String
  phone             String
  customerEmail     String?
  customerName      String?
  notes             String?         @db.Text
  paymentScreenshot String?         @db.Text
  paymentVerified   Boolean         @default(false)
  paymentNote       String?         @db.Text
  trackingLat       Float?
  trackingLng       Float?
  trackingNumber    String?
  trackingUrl       String?         @db.Text
  estimatedDays     Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  driverId          String?
  assignedAt        DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  codCollected      Boolean         @default(false)
  branchId          String?
  source            String          @default("STORE")
  createdBy         String?
  couponCode        String?
  discountAmount    Float           @default(0)
  attemptCounter    Int             @default(0)
  failureReason     String?         @db.Text

  // Logistics tracking fields
  packageContent            String?         @db.Text
  weight                    Float?
  otherFees                 Float           @default(0)
  additionalFees            Float           @default(0)
  consignmentNumber         String?
  providerConsignmentNumber String?
  customerReference         String?
  pendingAttempts           Int             @default(0)
  shipmentType              String?

  customer          User            @relation(fields: [customerId], references: [id])
  driver            DeliveryDriver? @relation(fields: [driverId], references: [id])
  items             OrderItem[]
  returns           Return[]
}

model OrderItem {
  id          String            @id @default(cuid())
  orderId     String
  productId   String
  vendorId    String
  quantity    Int
  priceAtTime Float
  size        String?
  color       String?
  variationId String?
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id])
  variation   ProductVariation? @relation(fields: [variationId], references: [id])
  vendor      Vendor            @relation(fields: [vendorId], references: [id])
}

model Withdrawal {
  id        String   @id @default(cuid())
  vendorId  String
  amount    Float
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
}

model Settings {
  id                  String  @id @default("global")
  exchangeRate        Float   @default(1.0)
  baseCurrency        String  @default("SDG")
  platformCommission  Float   @default(10.0)
  commissionType      String  @default("PERCENTAGE")
  fixedCommission     Float   @default(0.0)
  maintenanceMode     Boolean @default(false)
  maintenanceMessage  String  @default("هناك خطأ تقني يجري إصلاحه")
  codEnabled          Boolean @default(true)
  codExtraFee         Float   @default(2000)
  codCitiesOnly       String  @default("الخرطوم")
  bankTransferEnabled Boolean @default(true)
  bankName            String  @default("")
  bankAccountNumber   String  @default("")
  bankAccountName     String  @default("")
  contactEmail        String?
  contactPhone        String?
  facebookUrl         String?
  instagramUrl        String?
  logo                String?
  primaryColor        String  @default("#1089A4")
  secondaryColor      String  @default("#F29124")
  siteDescription     String  @default("أكبر منصة تسوق في السودان")
  siteTitle           String  @default("مرسال - تسوق بذكاء")
  whatsappNumber      String?
  bankAccounts        String? @db.Text
}

model SiteConfig {
  key   String @id
  value String @db.Text
}

model SiteBanner {
  id        String   @id @default(cuid())
  title     String?
  subtitle  String?
  imageUrl  String
  link      String?
  type      String   @default("HOME_HERO")
  targetId  String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String
  isActive  Boolean  @default(true)
  permissions Json?
  createdAt DateTime @default(now())
}

model DeliveryZone {
  id           String  @id @default(cuid())
  fromCity     String
  toCity       String
  fee          Float
  deliveryDays Int     @default(1)
  isActive     Boolean @default(true)
}

model ShippingProvider {
  id        String   @id @default(cuid())
  name      String
  apiKey    String
  baseUrl   String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DeliveryDriver {
  id                String                    @id @default(cuid())
  userId            String?                   @unique
  name              String
  phone             String                    @unique
  vehicleType       String
  isActive          Boolean                   @default(true)
  isOnline          Boolean                   @default(false)
  balance           Float                     @default(0)
  lat               Float?
  lng               Float?
  createdAt         DateTime                  @default(now())
  user              User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders            Order[]
  walletTransactions DriverWalletTransaction[]
}

model DriverWalletTransaction {
  id          String         @id @default(cuid())
  driverId    String
  amount      Float
  type        String         // COLLECTION (COD), SETTLEMENT, COMMISSION
  description String?
  orderId     String?
  createdAt   DateTime       @default(now())
  driver      DeliveryDriver @relation(fields: [driverId], references: [id])
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  location  String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  productId String
  userId    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model VendorReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  vendorId  String
  userId    String
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String
  discountValue  Float
  minOrderAmount Float?    @default(0)
  maxDiscount    Float?    @default(0)
  expiryDate     DateTime?
  isActive       Boolean   @default(true)
  vendorId       String?
  scope          String    @default("ALL")
  targetIds      String?   @db.Text
  createdAt      DateTime  @default(now())
  vendor         Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model SupplyRequest {
  id          String              @id @default(cuid())
  vendorId    String
  status      String              @default("PENDING") // PENDING, RECEIVED, CANCELLED
  totalItems  Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       SupplyRequestItem[]
  vendor      Vendor              @relation(fields: [vendorId], references: [id])
}

model SupplyRequestItem {
  id              String        @id @default(cuid())
  supplyRequestId String
  productId       String
  expectedQty     Int
  receivedQty     Int           @default(0)
  damagedQty      Int           @default(0)
  supplyRequest   SupplyRequest @relation(fields: [supplyRequestId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
}

// المرتجعات (Returns) — طلبات إرجاع الطلبات من العملاء
model Return {
  id           String       @id @default(cuid())
  orderId      String
  vendorId     String?
  customerId   String?
  reason       String       @db.Text
  status       String       @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, RECEIVED, REFUNDED
  refundAmount Float        @default(0)
  restock      Boolean      @default(true)
  adminNote    String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  resolvedAt   DateTime?
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items        ReturnItem[]

  @@index([orderId])
  @@index([vendorId])
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  productId String
  quantity  Int     @default(1)
  return    Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

// الباب الرابع: حفظ عناوين العملاء تلقائياً
model SavedAddress {
  id        String   @id @default(cuid())
  userId    String
  city      String
  district  String
  street    String
  label     String?  // "المنزل" أو "العمل"
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// الباب الثالث: نظام تسوية كاش المناديب
model DriverSettlement {
  id          String   @id @default(cuid())
  driverId    String
  totalCash   Float    // الكاش الإجمالي النظري
  actualCash  Float    // الكاش الفعلي المسلّم
  difference  Float    // الفرق (يجب أن يكون صفر)
  notes       String?  @db.Text
  settledBy   String?  // ID الموظف المحاسب
  orderIds    String   @db.Text  // JSON array of order IDs
  status      String   @default("PENDING") // PENDING, SETTLED, DISPUTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([driverId])
}

// نظام الإشعارات الفوري
model Notification {
  id        String   @id @default(cuid())
  userId    String?
  role      String?  // "ADMIN", "VENDOR", "DRIVER", "ALL"
  title     String
  message   String   @db.Text
  type      String   // "order", "withdrawal", "payment", "vendor", "system", "transfer"
  link      String?  // URL للتنقل عند الضغط
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([role])
  @@index([createdAt])
}

// نظام أمان شامل - سجل الأنشطة المشبوهة والهجمات
model SecurityLog {
  id          String   @id @default(cuid())
  // Event categorization
  type        String   // LOGIN_FAIL, LOGIN_SUCCESS, PAYMENT_FAIL, PAYMENT_SUCCESS,
                      // FAKE_RECEIPT, FAKE_CARD, RATE_LIMIT, SUSPICIOUS_PATTERN,
                      // SQL_INJECTION_ATTEMPT, XSS_ATTEMPT, UNAUTHORIZED_ACCESS,
                      // PASSWORD_RESET_ABUSE, PERMISSION_VIOLATION, API_ABUSE
  severity    String   @default("INFO") // INFO, WARN, ALERT, CRITICAL

  // Source identification
  ip          String?
  userAgent   String?  @db.Text
  userId      String?
  userEmail   String?
  vendorId    String?

  // Request context
  endpoint    String?  @db.VarChar(500)
  method      String?  // GET/POST/PUT/PATCH/DELETE

  // Free-form details (e.g. error messages, attempted payload, fraud flags)
  message     String?  @db.Text
  details     Json?

  // Admin actions
  resolved    Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  blocked     Boolean  @default(false)  // is the source IP now blocked

  createdAt   DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([ip])
  @@index([userEmail])
  @@index([createdAt])
}

// قائمة الحظر للـ IPs المشبوهة
model BlockedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?  @db.Text
  attempts  Int      @default(0)
  blockedAt DateTime @default(now())
  expiresAt DateTime? // null = permanent
  blockedBy String?

  @@index([ip])
  @@index([expiresAt])
}

// الباب الأول: طلبات استيراد الطلبات الخارجية
model ImportedOrder {
  id            String   @id @default(cuid())
  supplierId    String?
  supplierName  String
  customerName  String
  phone         String
  city          String
  district      String?
  street        String?
  productName   String
  quantity      Int      @default(1)
  price         Float
  notes         String?  @db.Text
  status        String   @default("PENDING") // PENDING, PROCESSED, CANCELLED
  source        String   @default("IMPORT") // FACEBOOK, WHATSAPP, IMPORT
  createdAt     DateTime @default(now())
  processedAt   DateTime?

  @@index([supplierId])
}

model ShippingRegion {
  id           String   @id @default(cuid())
  state        String
  city         String
  shippingRate Float    @default(0.0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
